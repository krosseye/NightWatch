FROM python:3.12.4

ENV DEBIAN_FRONTEND=noninteractive

VOLUME /app/

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv
COPY dockerfiles/entrypoint.sh /entrypoint.sh

RUN apt update \
    && apt install -y \
    binutils \
    gcc \
    zlib1g-dev \
    && apt clean \
    && rm -rf \
    /var/lib/apt/lists/* \
    /var/cache/* \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
