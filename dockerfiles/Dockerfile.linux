FROM almalinux:8.10

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv

ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_PROJECT_ENVIRONMENT=/opt/uv/venv \
    UV_LINK_MODE=copy \
    LD_LIBRARY_PATH=/opt/uv/python/current/lib

RUN dnf install -y binutils \
    && dnf clean all \
    && uv python install 3.12 \
    && ln -s /opt/uv/python/cpython-3.12.*-linux-x86_64-gnu /opt/uv/python/current

VOLUME /app/
WORKDIR /app

CMD ["uv", "run", "--frozen", "--no-default-groups", "--group", "build", "python", "build.py"]
